{
  "name": "io.github.scarfmeister.pear-streamdeck.sdplugin",
  "version": "2.3.0",
  "description": "Pear Desktop Connector development fork of YTMD-StreamDeck",
  "scripts": {
    "watch": "node scripts/watch.js",
    "build": "node scripts/build.js",
    "prepare:streamdeck-cli": "node scripts/prepare-streamdeck-cli.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "validate:localization": "node scripts/validate-localization.js",
    "validate:package": "python3 scripts/validate-package.py",
    "test": "node scripts/test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Scarfmeister/Pear-StreamDeck.git"
  },
  "author": "XeroxDev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Scarfmeister/Pear-StreamDeck/issues"
  },
  "homepage": "https://github.com/Scarfmeister/Pear-StreamDeck/tree/dev/pear-port#readme",
  "dependencies": {
    "intl-messageformat": "^10.7.10",
    "streamdeck-typescript": "^3.3.4"
  },
  "keywords": [
    "music",
    "plugin",
    "streamdeck",
    "stream-deck",
    "pear-desktop",
    "media-controls"
  ],
  "devDependencies": {
    "@commitlint/cli": "^18.6.0",
    "@commitlint/config-conventional": "^18.6.0",
    "@tsconfig/recommended": "^1.0.3",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.10",
    "husky": "^3.1.0",
    "typescript": "^5.3.3",
    "ytmdesktop-ts-companion": "^1.1.0"
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}
