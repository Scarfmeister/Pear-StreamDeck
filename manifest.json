{
  "Name": "Pear Desktop Connector",
  "Author": "XeroxDev; Matthew Wallace (Scarfmeister)",
  "Description": "Pear Desktop Connector development fork. See the repository for implementation status.",
  "URL": "https://github.com/Scarfmeister/Pear-StreamDeck",
  "UUID": "io.github.scarfmeister.pear-streamdeck",
  "Icon": "icons/action-image",
  "Version": "2.3.0",
  "Category": "Pear Desktop",
  "CategoryIcon": "icons/category-icon",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "10.11"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Icon": "icons/music-play",
      "Name": "Play-Pause",
      "States": [
        {
          "Image": "icons/music-play",
          "TitleAlignment": "middle",
          "FontSize": 16
        },
        {
          "Image": "icons/music-pause",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "DisableAutomaticStates": true,
      "Encoder": {
        "layout": "$B1",
        "StackColor": "#AABBCC",
        "TriggerDescription": {
          "Rotate": "Switch song",
          "Push": "Plays or Pauses the current song"
        }
      },
      "SupportedInMultiActions": true,
      "Tooltip": "Plays or Pauses the current song",
      "UUID": "io.github.scarfmeister.pear-streamdeck.play-pause"
    },
    {
      "Icon": "icons/music-next",
      "Name": "Next",
      "States": [
        {
          "Image": "icons/music-next",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Go to next song",
      "UUID": "io.github.scarfmeister.pear-streamdeck.next"
    },
    {
      "Icon": "icons/music-prev",
      "Name": "Prev",
      "States": [
        {
          "Image": "icons/music-prev",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Go to prev song",
      "UUID": "io.github.scarfmeister.pear-streamdeck.prev"
    },
    {
      "Icon": "icons/like-on",
      "Name": "Like",
      "States": [
        {
          "Image": "icons/like-off",
          "TitleAlignment": "middle",
          "FontSize": 16
        },
        {
          "Image": "icons/like-on",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Likes current song",
      "UUID": "io.github.scarfmeister.pear-streamdeck.like",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/dislike-on",
      "Name": "Dislike",
      "States": [
        {
          "Image": "icons/dislike-off",
          "TitleAlignment": "middle",
          "FontSize": 16
        },
        {
          "Image": "icons/dislike-on",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Dislikes current song",
      "UUID": "io.github.scarfmeister.pear-streamdeck.dislike",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/volume-on",
      "Name": "Mute",
      "States": [
        {
          "Image": "icons/volume-on",
          "TitleAlignment": "middle",
          "FontSize": 16
        },
        {
          "Image": "icons/volume-mute",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Mutes / unmutes volume",
      "UUID": "io.github.scarfmeister.pear-streamdeck.mute",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/volume-down",
      "Name": "Volume Down",
      "States": [
        {
          "Image": "icons/volume-down",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Volume Down",
      "UUID": "io.github.scarfmeister.pear-streamdeck.volume-down"
    },
    {
      "Icon": "icons/volume-up",
      "Name": "Volume Up",
      "States": [
        {
          "Image": "icons/volume-up",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "DisableAutomaticStates": false,
      "Encoder": {
        "layout": "$B1",
        "StackColor": "#AABBCC",
        "TriggerDescription": {
          "Rotate": "Volume control",
          "Push": "Mute"
        }
      },
      "SupportedInMultiActions": true,
      "Tooltip": "Volume Up",
      "UUID": "io.github.scarfmeister.pear-streamdeck.volume-up"
    },
    {
      "Icon": "icons/action-image",
      "Name": "Track Info",
      "States": [
        {
          "Image": "icons/action-image",
          "TitleAlignment": "middle",
          "FontSize": 10,
          "FontFamily": "Arial",
          "FontStyle": "Regular"
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Track title and artist; press to play or pause",
      "UUID": "io.github.scarfmeister.pear-streamdeck.song-info"
    },
    {
      "Icon": "icons/shuffle",
      "Name": "Shuffle",
      "States": [
        {
          "Image": "icons/shuffle-off",
          "TitleAlignment": "bottom",
          "FontSize": 12
        },
        {
          "Image": "icons/shuffle-on",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Shuffle",
      "UUID": "io.github.scarfmeister.pear-streamdeck.shuffle",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/repeat",
      "Name": "Repeat",
      "States": [
        {
          "Image": "icons/repeat-none",
          "TitleAlignment": "bottom",
          "FontSize": 12
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Repeat",
      "UUID": "io.github.scarfmeister.pear-streamdeck.repeat",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/music-play",
      "Name": "Play Playlist",
      "States": [
        {
          "Image": "icons/music-play",
          "TitleAlignment": "middle",
          "FontSize": 16
        }
      ],
      "SupportedInMultiActions": true,
      "Tooltip": "Play a selected playlist",
      "UUID": "io.github.scarfmeister.pear-streamdeck.play-playlist"
    }
  ],
  "CodePath": "action.html",
  "PropertyInspectorPath": "property-inspector.html"
}
