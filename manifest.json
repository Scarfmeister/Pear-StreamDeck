{
  "Name": "Pear Desktop Connector",
  "Author": "XeroxDev; Matthew Wallace (Scarfmeister)",
  "Description": "Control Pear Desktop from Stream Deck keys and dials using its local API Server.",
  "UUID": "io.github.scarfmeister.pear-streamdeck",
  "Icon": "icons/plugin-icon",
  "Version": "2.3.0.0",
  "Category": "Pear Desktop",
  "CategoryIcon": "icons/category-icon",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "13"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "11"
    }
  ],
  "Actions": [
    {
      "Icon": "icons/music-play",
      "Name": "Play/Pause",
      "States": [
        {
          "Image": "icons/music-play",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Play"
        },
        {
          "Image": "icons/music-pause",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Pause"
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "DisableAutomaticStates": true,
      "Encoder": {
        "layout": "dial-layout.json",
        "StackColor": "#AABBCC",
        "TriggerDescription": {
          "Rotate": "Clockwise next track; counter-clockwise previous track",
          "Push": "Play or pause",
          "Touch": "Refresh display"
        }
      },
      "SupportedInMultiActions": false,
      "Tooltip": "Start or pause the current track",
      "UUID": "io.github.scarfmeister.pear-streamdeck.play-pause"
    },
    {
      "Icon": "icons/music-next",
      "Name": "Next Track",
      "States": [
        {
          "Image": "icons/music-next",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Next Track"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Go to the next track",
      "UUID": "io.github.scarfmeister.pear-streamdeck.next"
    },
    {
      "Icon": "icons/music-prev",
      "Name": "Previous Track",
      "States": [
        {
          "Image": "icons/music-prev",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Previous Track"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Go to the previous track",
      "UUID": "io.github.scarfmeister.pear-streamdeck.prev"
    },
    {
      "Icon": "icons/like-on",
      "Name": "Like Track",
      "States": [
        {
          "Image": "icons/like-off",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Off"
        },
        {
          "Image": "icons/like-on",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Like Track"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Like or clear Like for the current track",
      "UUID": "io.github.scarfmeister.pear-streamdeck.like",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/dislike-on",
      "Name": "Dislike Track",
      "States": [
        {
          "Image": "icons/dislike-off",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Off"
        },
        {
          "Image": "icons/dislike-on",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Dislike Track"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Dislike or clear Dislike for the current track",
      "UUID": "io.github.scarfmeister.pear-streamdeck.dislike",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/volume-on",
      "Name": "Mute",
      "States": [
        {
          "Image": "icons/volume-on",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Volume"
        },
        {
          "Image": "icons/volume-mute",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Muted"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Toggle mute on/off",
      "UUID": "io.github.scarfmeister.pear-streamdeck.mute",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/volume-down",
      "Name": "Volume Down",
      "States": [
        {
          "Image": "icons/volume-down",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Volume Down"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Turn the player volume down",
      "UUID": "io.github.scarfmeister.pear-streamdeck.volume-down"
    },
    {
      "Icon": "icons/volume-up",
      "Name": "Volume Up",
      "States": [
        {
          "Image": "icons/volume-up",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Volume Up"
        }
      ],
      "Controllers": [
        "Keypad",
        "Encoder"
      ],
      "DisableAutomaticStates": false,
      "Encoder": {
        "layout": "$B1",
        "StackColor": "#AABBCC",
        "TriggerDescription": {
          "Rotate": "Adjust volume by the configured step",
          "Push": "Toggle mute",
          "Touch": "Refresh display"
        }
      },
      "SupportedInMultiActions": false,
      "Tooltip": "Turn the player volume up",
      "UUID": "io.github.scarfmeister.pear-streamdeck.volume-up"
    },
    {
      "Icon": "icons/action-image",
      "Name": "Track Info",
      "States": [
        {
          "Image": "icons/action-image",
          "TitleAlignment": "middle",
          "FontSize": 10,
          "FontFamily": "Arial",
          "FontStyle": "Regular",
          "Name": "Track Info"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Show track metadata; press to play or pause",
      "UUID": "io.github.scarfmeister.pear-streamdeck.song-info"
    },
    {
      "Icon": "icons/shuffle",
      "Name": "Shuffle",
      "States": [
        {
          "Image": "icons/shuffle-off",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "Name": "Off"
        },
        {
          "Image": "icons/shuffle-on",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "Name": "Shuffle"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Toggle real shuffle state",
      "UUID": "io.github.scarfmeister.pear-streamdeck.shuffle",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/repeat",
      "Name": "Repeat Mode",
      "States": [
        {
          "Image": "icons/repeat-none",
          "TitleAlignment": "bottom",
          "FontSize": 12,
          "Name": "Off"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Cycle repeat: Off, All, One",
      "UUID": "io.github.scarfmeister.pear-streamdeck.repeat",
      "DisableAutomaticStates": true
    },
    {
      "Icon": "icons/playlist",
      "Name": "Play Playlist",
      "States": [
        {
          "Image": "icons/playlist",
          "TitleAlignment": "middle",
          "FontSize": 16,
          "Name": "Play Playlist"
        }
      ],
      "SupportedInMultiActions": false,
      "Tooltip": "Start a configured playlist with native Play or Shuffle Play",
      "UUID": "io.github.scarfmeister.pear-streamdeck.play-playlist"
    },
    {
      "Icon": "icons/volume-on",
      "Name": "Volume Dial",
      "States": [
        {
          "Image": "icons/volume-on",
          "Name": "Volume Dial"
        }
      ],
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "$B1",
        "StackColor": "#5D9981",
        "TriggerDescription": {
          "Rotate": "Adjust volume by the configured step",
          "Push": "Toggle mute",
          "Touch": "Refresh display"
        }
      },
      "SupportedInMultiActions": false,
      "Tooltip": "Rotate for volume; press to mute. Shows actual Pear state.",
      "UUID": "io.github.scarfmeister.pear-streamdeck.volume-dial"
    },
    {
      "Icon": "icons/music-play",
      "Name": "Transport Dial",
      "States": [
        {
          "Image": "icons/music-play",
          "Name": "Transport Dial"
        }
      ],
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "dial-layout.json",
        "StackColor": "#5D9981",
        "TriggerDescription": {
          "Rotate": "Clockwise next track; counter-clockwise previous track",
          "Push": "Play or pause",
          "Touch": "Refresh display"
        }
      },
      "SupportedInMultiActions": false,
      "Tooltip": "Rotate to change tracks; press to play or pause. Shows actual Pear state.",
      "UUID": "io.github.scarfmeister.pear-streamdeck.transport-dial"
    },
    {
      "Icon": "icons/playlist",
      "Name": "Playlist Selector Dial",
      "States": [
        {
          "Image": "icons/playlist",
          "Name": "Playlist Selector Dial"
        }
      ],
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "dial-layout.json",
        "StackColor": "#5D9981",
        "TriggerDescription": {
          "Rotate": "Select a configured playlist",
          "Push": "Play the selected playlist",
          "Touch": "Refresh display"
        }
      },
      "SupportedInMultiActions": false,
      "Tooltip": "Select and play a named playlist; requires the Pear playlist API extension.",
      "UUID": "io.github.scarfmeister.pear-streamdeck.playlist-selector"
    }
  ],
  "CodePath": "action.html",
  "PropertyInspectorPath": "property-inspector.html"
}
